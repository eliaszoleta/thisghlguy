---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string[];
  canonical?: string;
  ogImage?: string;
  publishDate?: Date;
  updatedDate?: Date;
  author?: string;
  articleSchema?: object;
  faqSchema?: object[];
  breadcrumbSchema?: object[];
  extraSchemas?: object[];
  noindex?: boolean;
}

const {
  title,
  description,
  keywords = [],
  canonical,
  ogImage = '/og-default.png',
  publishDate,
  updatedDate,
  author,
  articleSchema,
  faqSchema,
  breadcrumbSchema,
  extraSchemas = [],
  noindex = false,
} = Astro.props;

const siteUrl = 'https://thisghlguy.com';
const canonicalURL = canonical ? `${siteUrl}${canonical}` : Astro.url.href;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ThisGHLGuy',
  url: siteUrl,
  description: 'The complete GoHighLevel resource for agencies and SaaS builders.',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const schemas = [websiteSchema];
if (articleSchema) schemas.push(articleSchema);
if (breadcrumbSchema) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbSchema,
  });
}
if (faqSchema && faqSchema.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqSchema.map((f: any) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  });
}
for (const s of extraSchemas) schemas.push(s);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}

    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={articleSchema ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:site_name" content="ThisGHLGuy" />
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Favicons -->
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/thisghlguy-favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/thisghlguy-favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/thisghlguy-android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/thisghlguy-android-chrome-512x512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/thisghlguy-apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="application-name" content="ThisGHLGuy" />
    <meta name="theme-color" content="#1e40af" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CH914VV2MN"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CH914VV2MN');
    </script>

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&display=swap" rel="stylesheet" />

    <!-- Schema Markup -->
    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      const AFFILIATE = 'https://www.gohighlevel.com/?fp_ref=thisghlguy';
      const AFFILIATE_FIRED_KEY = 'ghl_aff_fired';

      document.addEventListener('click', (e) => {
        const link = (e.target as Element).closest<HTMLAnchorElement>('[data-affiliate-link]');
        if (!link) return;
        e.preventDefault();
        window.open(link.href, '_blank');
        if (!localStorage.getItem(AFFILIATE_FIRED_KEY)) {
          localStorage.setItem(AFFILIATE_FIRED_KEY, '1');
          window.location.href = AFFILIATE;
        }
      });
    </script>
  </body>
</html>
