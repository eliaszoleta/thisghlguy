---
const categories = [
  { label: 'GoHighLevel Basics', href: '/gohighlevel-basics/' },
  { label: 'Features', href: '/gohighlevel-features/' },
  { label: 'Automation', href: '/gohighlevel-automation/' },
  { label: 'SaaS Mode', href: '/gohighlevel-saas/' },
  { label: 'Comparisons', href: '/gohighlevel-comparisons/' },
  { label: 'Tutorials', href: '/gohighlevel-tutorials/' },
];

const popularArticles = [
  { label: 'What is GoHighLevel?', href: '/what-is-gohighlevel/' },
  { label: 'GoHighLevel Pricing', href: '/gohighlevel-pricing/' },
  { label: 'Is GoHighLevel Worth It?', href: '/is-gohighlevel-worth-it/' },
  { label: 'GHL vs ClickFunnels', href: '/gohighlevel-vs-clickfunnels/' },
  { label: 'GoHighLevel SaaS Mode', href: '/what-is-gohighlevel-saas-mode/' },
  { label: 'GHL Setup Guide', href: '/how-to-set-up-gohighlevel/' },
];

const year = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2 font-bold text-xl text-white mb-4">
          <img src="/thisghlguy-logo.png" alt="ThisGHLGuy - GoHighLevel Expert" width="48" height="48" loading="lazy" class="h-12 w-12 object-contain" />
          <span style="font-family: 'Poppins', sans-serif; font-weight: 700;">ThisGHLGuy</span>
        </a>
        <p class="text-sm text-gray-400 leading-relaxed mb-6">
          The #1 resource for GoHighLevel users, agencies, and SaaS builders. Deep guides, honest reviews, and actionable tutorials.
        </p>
        <a
          href="https://www.gohighlevel.com/?fp_ref=thisghlguy"
          target="_blank"
          rel="sponsored noopener noreferrer"
          class="inline-block px-5 py-2.5 bg-brand-600 text-white text-sm font-semibold rounded-lg hover:bg-brand-700 transition-colors"
        >
          Try GoHighLevel Free →
        </a>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Categories</h3>
        <ul class="space-y-2">
          {categories.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Popular Articles -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Popular Articles</h3>
        <ul class="space-y-2">
          {popularArticles.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Disclosure -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Disclosure</h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          ThisGHLGuy.com participates in the GoHighLevel affiliate program. We may earn a commission if you sign up through our links — at no extra cost to you. Our reviews are honest and independent.
        </p>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-gray-800 flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-gray-500">
      <p>© {year} ThisGHLGuy. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/about/" class="hover:text-white transition-colors">About</a>
        <a href="/privacy-policy/" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="/terms/" class="hover:text-white transition-colors">Terms</a>
        <a href="/sitemap-index.xml" class="hover:text-white transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
