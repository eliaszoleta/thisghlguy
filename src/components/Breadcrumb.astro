---
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-1 text-gray-500">
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && (
          <svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        )}
        {i === items.length - 1 ? (
          <span class="text-gray-900 font-medium truncate max-w-[200px]" aria-current="page">
            {item.name}
          </span>
        ) : (
          <a href={item.url} class="hover:text-brand-600 hover:underline transition-colors whitespace-nowrap">
            {item.name}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>
