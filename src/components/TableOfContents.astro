---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length > 0 && (
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-5">
    <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-4 flex items-center gap-2">
      <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h10M4 18h10" />
      </svg>
      Table of Contents
    </h2>
    <nav aria-label="Table of contents">
      <ul class="space-y-1.5 text-sm">
        {tocHeadings.map((heading) => (
          <li class={`toc-item${heading.depth === 3 ? ' pl-4' : ''}`}>
            <a
              href={`#${heading.slug}`}
              class="toc-link text-gray-600 hover:text-brand-600 transition-colors leading-snug block py-0.5"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
)}

<style>
  .toc-link.toc-active {
    color: #2563eb;
    font-weight: 600;
  }
  .toc-item.toc-item-active {
    border-left: 2px solid #2563eb;
    padding-left: 0.5rem;
  }
  /* keep indent for h3 items when active */
  .toc-item.pl-4.toc-item-active {
    padding-left: 1.5rem;
  }
</style>

<script>
  function initTOC() {
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));
    if (tocLinks.length === 0) return;

    const sectionEls = tocLinks.map((l) => {
      const id = l.getAttribute('href')?.slice(1);
      return id ? document.getElementById(id) : null;
    });

    let currentActive = -1;

    function activate(idx: number) {
      if (idx === currentActive) return;
      currentActive = idx;
      tocLinks.forEach((link, i) => {
        const isActive = i === idx;
        link.classList.toggle('toc-active', isActive);
        link.parentElement?.classList.toggle('toc-item-active', isActive);
      });
    }

    function onScroll() {
      // The active section is the last heading whose top is above 25% of the viewport
      const threshold = window.scrollY + window.innerHeight * 0.25;
      let best = 0;
      sectionEls.forEach((el, i) => {
        if (el && el.offsetTop <= threshold) best = i;
      });
      activate(best);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll(); // set initial state on load
  }

  // Run after DOM is ready (handles both first load and client-side nav)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTOC);
  } else {
    initTOC();
  }
</script>
