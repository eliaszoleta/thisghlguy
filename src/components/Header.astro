---
const navLinks = [
  { label: 'Basics', href: '/gohighlevel-basics/' },
  { label: 'Features', href: '/gohighlevel-features/' },
  { label: 'Automation', href: '/gohighlevel-automation/' },
  { label: 'SaaS Mode', href: '/gohighlevel-saas/' },
  { label: 'Comparisons', href: '/gohighlevel-comparisons/' },
  { label: 'Tutorials', href: '/gohighlevel-tutorials/' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 font-bold text-xl text-gray-900 hover:opacity-90 transition-opacity">
        <img src="/thisghlguy-logo.png" alt="ThisGHLGuy - GoHighLevel Expert" width="56" height="56" class="h-14 w-14 object-contain" />
        <span style="font-family: 'Poppins', sans-serif; font-weight: 700;">ThisGHLGuy</span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${
              currentPath.startsWith(link.href)
                ? 'text-brand-600 bg-brand-50'
                : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA + Mobile Menu Button -->
      <div class="flex items-center gap-3">
        <a
          href="https://www.gohighlevel.com/?fp_ref=thisghlguy"
          target="_blank"
          rel="sponsored noopener noreferrer"
          class="hidden sm:inline-flex items-center px-4 py-2 bg-brand-600 text-white text-sm font-semibold rounded-lg hover:bg-brand-700 transition-colors"
        >
          Try GHL Free
        </a>

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Nav -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-200 bg-white">
    <nav class="px-4 py-3 space-y-1" aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`block px-3 py-2 rounded-md text-sm font-medium transition-colors ${
            currentPath.startsWith(link.href)
              ? 'text-brand-600 bg-brand-50'
              : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://www.gohighlevel.com/?fp_ref=thisghlguy"
        target="_blank"
        rel="noopener noreferrer"
        class="block mt-2 px-3 py-2 bg-brand-600 text-white text-sm font-semibold rounded-lg text-center hover:bg-brand-700 transition-colors"
      >
        Try GoHighLevel Free
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
