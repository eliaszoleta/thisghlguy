---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CategorySearch from '@/components/CategorySearch.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles', ({ data }) => data.category === 'gohighlevel-comparisons');
const sorted = articles.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'GoHighLevel vs Competitors',
  description: 'How does GoHighLevel stack up against ClickFunnels, HubSpot, ActiveCampaign, Kajabi, and more? Read our detailed, side-by-side comparisons.',
  url: 'https://www.thisghlguy.com/gohighlevel-comparisons/',
  hasPart: sorted.map((a) => ({
    '@type': 'Article',
    headline: a.data.title,
    url: `https://www.thisghlguy.com/${a.id}/`,
  })),
};
---

<BaseLayout
  title="GoHighLevel vs Competitors – Honest Comparisons | ThisGHLGuy"
  description="How does GoHighLevel stack up against ClickFunnels, HubSpot, ActiveCampaign, Kajabi, and more? Read our detailed, side-by-side comparisons."
  keywords={['GoHighLevel vs ClickFunnels', 'GoHighLevel vs HubSpot', 'GoHighLevel vs ActiveCampaign', 'GHL alternatives', 'GoHighLevel comparison']}
  canonical="/gohighlevel-comparisons/"
  extraSchemas={[collectionSchema]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumb items={[{ name: 'Home', url: '/' }, { name: 'Comparisons', url: '/gohighlevel-comparisons/' }]} />

    <header class="mt-8 mb-12 max-w-3xl">
      <span class="text-xs font-bold uppercase tracking-widest text-red-600 bg-red-50 px-3 py-1 rounded-full">Comparisons</span>
      <h1 class="text-4xl font-extrabold text-gray-900 mt-4 mb-4">GoHighLevel vs Competitors</h1>
      <p class="text-xl text-gray-600">
        Wondering how GoHighLevel compares to other platforms? We've done the research so you don't have to. Honest, side-by-side comparisons with real verdict.
      </p>
    </header>

    <CategorySearch articles={sorted} />
  </div>
</BaseLayout>
