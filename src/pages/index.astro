---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const featured = allArticles.filter((a) => a.data.featured).slice(0, 3);
const recent = allArticles
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 6);

const categories = [
  {
    slug: 'gohighlevel-basics',
    label: 'GoHighLevel Basics',
    icon: '🚀',
    desc: 'New to GHL? Start here. Pricing, reviews, and who it\'s for.',
    color: 'bg-blue-50 border-blue-200 hover:border-blue-400',
    iconBg: 'bg-blue-100',
  },
  {
    slug: 'gohighlevel-features',
    label: 'Features',
    icon: '⚙️',
    desc: 'Deep dives into CRM, funnels, email, SMS, pipelines, and more.',
    color: 'bg-purple-50 border-purple-200 hover:border-purple-400',
    iconBg: 'bg-purple-100',
  },
  {
    slug: 'gohighlevel-automation',
    label: 'Automation',
    icon: '🤖',
    desc: 'Build powerful workflows that run your business on autopilot.',
    color: 'bg-green-50 border-green-200 hover:border-green-400',
    iconBg: 'bg-green-100',
  },
  {
    slug: 'gohighlevel-saas',
    label: 'SaaS Mode',
    icon: '💰',
    desc: 'White-label GHL and resell it as your own SaaS product.',
    color: 'bg-orange-50 border-orange-200 hover:border-orange-400',
    iconBg: 'bg-orange-100',
  },
  {
    slug: 'gohighlevel-comparisons',
    label: 'Comparisons',
    icon: '⚖️',
    desc: 'GHL vs ClickFunnels, HubSpot, ActiveCampaign, and more.',
    color: 'bg-red-50 border-red-200 hover:border-red-400',
    iconBg: 'bg-red-100',
  },
  {
    slug: 'gohighlevel-tutorials',
    label: 'Tutorials',
    icon: '📚',
    desc: 'Step-by-step guides to set up and master GoHighLevel.',
    color: 'bg-teal-50 border-teal-200 hover:border-teal-400',
    iconBg: 'bg-teal-100',
  },
];

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'ThisGHLGuy – The #1 GoHighLevel Resource',
  description: 'Complete GoHighLevel guides, tutorials, comparisons, and SaaS mode walkthroughs for agencies and entrepreneurs.',
  url: 'https://thisghlguy.com',
};
---

<BaseLayout
  title="ThisGHLGuy – The #1 GoHighLevel Resource for Agencies & SaaS Builders"
  description="Complete GoHighLevel guides, tutorials, reviews, and comparisons. Learn how to use GHL to grow your agency, automate your marketing, and launch a SaaS business."
  keywords={['GoHighLevel guide', 'GoHighLevel tutorials', 'GHL review', 'GoHighLevel agency', 'GoHighLevel SaaS']}
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-900 via-brand-800 to-brand-700 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-brand-200 bg-white/10 px-4 py-1.5 rounded-full mb-6">
        The GoHighLevel Authority Resource
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight mb-6">
        Master GoHighLevel.<br />
        <span class="text-yellow-400">Grow Your Agency.</span>
      </h1>
      <p class="text-xl text-brand-100 max-w-2xl mx-auto mb-10 leading-relaxed">
        In-depth guides, honest reviews, step-by-step tutorials, and expert comparisons — everything you need to get the most out of GoHighLevel.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/what-is-gohighlevel/"
          class="px-8 py-4 bg-yellow-400 text-gray-900 font-bold rounded-xl hover:bg-yellow-300 transition-colors text-lg"
        >
          Start Here: What is GHL?
        </a>
        <a
          href="https://www.gohighlevel.com/?fp_ref=thisghlguy"
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 bg-white/10 text-white font-semibold rounded-xl hover:bg-white/20 transition-colors border border-white/30 text-lg"
        >
          Try GoHighLevel Free →
        </a>
      </div>
      <!-- Social proof -->
      <p class="mt-8 text-sm text-brand-300">
        Join thousands of agency owners and SaaS builders using GHL to scale their businesses.
      </p>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-3">Browse by Topic</h2>
        <p class="text-gray-600 max-w-xl mx-auto">Whether you're just starting or scaling your SaaS, we have the guides you need.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {categories.map((cat) => (
          <a
            href={`/${cat.slug}/`}
            class={`group flex items-start gap-4 p-6 rounded-xl border-2 transition-all duration-200 ${cat.color}`}
          >
            <span class={`text-2xl w-12 h-12 flex items-center justify-center rounded-xl flex-shrink-0 ${cat.iconBg}`}>
              {cat.icon}
            </span>
            <div>
              <h3 class="font-bold text-gray-900 text-lg mb-1 group-hover:text-brand-700 transition-colors">
                {cat.label}
              </h3>
              <p class="text-sm text-gray-600">{cat.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick Answer Box -->
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-brand-50 border border-brand-200 rounded-2xl p-8">
        <div class="flex items-start gap-4">
          <span class="text-3xl">💡</span>
          <div>
            <h2 class="text-xl font-bold text-brand-900 mb-2">What is GoHighLevel?</h2>
            <p class="text-brand-800 leading-relaxed mb-4">
              GoHighLevel (GHL) is an all-in-one marketing and CRM platform built specifically for digital marketing agencies. It combines a CRM, email marketing, SMS, funnel builder, website builder, booking calendar, pipeline management, and more — all under one roof.
            </p>
            <a href="/what-is-gohighlevel/" class="inline-flex items-center gap-1 text-brand-600 font-semibold hover:underline">
              Read the complete guide
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent Articles -->
  {recent.length > 0 && (
    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-10">
          <h2 class="text-3xl font-bold text-gray-900">Latest Articles</h2>
          <a href="/gohighlevel-basics/" class="text-brand-600 font-semibold hover:underline text-sm">
            View all →
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {recent.map((article) => <ArticleCard article={article} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Why GHL / CTA Banner -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">Why GoHighLevel is the #1 Agency Platform</h2>
      <p class="text-gray-600 mb-8 leading-relaxed">
        GoHighLevel replaces 8–12 different tools with a single platform. CRM, funnels, email, SMS, booking, automation, white-label — all included. Most agencies save $500–$2,000/month by switching.
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 mb-10">
        {[
          { stat: '50,000+', label: 'Agencies using GHL' },
          { stat: '$1,400+', label: 'Avg monthly tool savings' },
          { stat: '8-in-1', label: 'Tools replaced' },
          { stat: '14 days', label: 'Free trial' },
        ].map((item) => (
          <div class="bg-gray-50 rounded-xl p-4">
            <p class="text-2xl font-extrabold text-brand-600 mb-1">{item.stat}</p>
            <p class="text-xs text-gray-600 font-medium">{item.label}</p>
          </div>
        ))}
      </div>
      <a
        href="https://www.gohighlevel.com/?fp_ref=thisghlguy"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-4 bg-brand-600 text-white font-bold rounded-xl hover:bg-brand-700 transition-colors text-lg"
      >
        Start Your Free 14-Day Trial →
      </a>
      <p class="mt-3 text-sm text-gray-400">Cancel anytime.</p>
    </div>
  </section>
</BaseLayout>
